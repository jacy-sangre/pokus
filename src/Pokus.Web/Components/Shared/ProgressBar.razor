<div class="h-1.5 w-full overflow-hidden rounded-full bg-sunken" role="progressbar" aria-label="@Label"
     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Math.Round(Value * 100))">
    <div class="h-full rounded-full bg-accent transition-[width] duration-500" style="width: @((Math.Clamp(Value, 0, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
</div>

@code {
    /// <summary>0 to 1.</summary>
    [Parameter] public double Value { get; set; }
    [Parameter] public string? Label { get; set; }
}
